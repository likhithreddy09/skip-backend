# development | production
APP_ENV=development

# MongoDB Atlas / self-hosted. Empty in development = in-memory mock DB (data lost on restart).
MONGODB_URI=
MONGODB_DB=skipmint

# Long random strings: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OTP_PEPPER=change-me

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# SMS OTP: console (dev, logs the code) | msg91 | twilio
OTP_PROVIDER=console
OTP_LENGTH=6
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OroPocket — server only. oro_test_… = sandbox, oro_live_… = real money.
OROPOCKET_API_KEY=
OROPOCKET_WEBHOOK_SECRET=
# Raw-API buys debit the partner float. Hosted Embed is the default path.
ENABLE_RAW_TRADING=false

# Comma-separated, or * for any origin
CORS_ORIGINS=*
# memory:// for one process; redis://… when running several workers
RATELIMIT_STORAGE_URI=memory://

PORT=8000
