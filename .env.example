# development | production
APP_ENV=development

# MongoDB Atlas / self-hosted. Empty in development = in-memory mock DB (data lost on restart).
MONGODB_URI=
MONGODB_DB=skipmint

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In. Comma-separated OAuth client IDs from your Google Cloud project
# that are valid audiences for the ID token (Android, iOS and/or Web client IDs).
# Required in production. Create them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_IDS=

# OroPocket — server only. oro_test_… = sandbox, oro_live_… = real money.
OROPOCKET_API_KEY=
OROPOCKET_WEBHOOK_SECRET=
# Raw-API buys debit the partner float. Hosted Embed is the default path.
ENABLE_RAW_TRADING=false

# Comma-separated, or * for any origin
CORS_ORIGINS=*
# memory:// for one process; redis://… when running several workers
RATELIMIT_STORAGE_URI=memory://

PORT=8000
